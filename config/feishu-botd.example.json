{
  "feishu": {
    "app_id": "REPLACE_WITH_DEFAULT_FEISHU_APP_ID",
    "app_secret": "REPLACE_WITH_DEFAULT_FEISHU_APP_SECRET"
  },
  "apps": {
    "support": {
      "app_id": "REPLACE_WITH_SUPPORT_FEISHU_APP_ID",
      "app_secret": "REPLACE_WITH_SUPPORT_FEISHU_APP_SECRET",
      "commands": {
        "enabled": true,
        "allow_unconfigured_group_chats": false,
        "bot_open_id": "REPLACE_WITH_SUPPORT_FEISHU_BOT_OPEN_ID",
        "bot_user_id": "",
        "bot_union_id": "",
        "bot_names": ["Support Bot"]
      },
      "channels": {
        "support": "REPLACE_WITH_FEISHU_CHAT_ID_SUPPORT"
      }
    }
  },
  "listeners": {
    "http_socket": "/run/feishu-botd/feishu-botd.sock",
    "http_bind": "0.0.0.0:7345",
    "grpc_socket": "/run/feishu-botd/feishu-botd.grpc.sock",
    "auth_token_file": "/run/secrets/feishu-botd-token",
    "allow_non_loopback_bind": true
  },
  "state_dir": "/var/lib/feishu-botd",
  "agent_providers": {
    "example-agent": {
      "auth_token_file": "/run/secrets/feishu-botd-example-agent-token",
      "allowed_apps": ["default", "support"],
      "allowed_commands": [],
      "allow_unmatched_messages": true,
      "allow_card_actions": true,
      "allow_attached_context": false,
      "allow_follow_up_messages": false,
      "allow_message_reactions": false,
      "allow_legacy_commands": false
    }
  },
  "commands": {
    "enabled": false,
    "allow_unconfigured_group_chats": false,
    "bot_open_id": "REPLACE_WITH_DEFAULT_FEISHU_BOT_OPEN_ID",
    "bot_user_id": "",
    "bot_union_id": "",
    "bot_names": ["Feishu Bot"],
    "scripts": {
      "enabled": false,
      "command": "ops",
      "dir": "/etc/feishu-botd/scripts",
      "allowed_chats": ["ci"],
      "timeout_seconds": 300
    }
  },
  "channels": {
    "ci": "REPLACE_WITH_FEISHU_CHAT_ID_CI",
    "ops": "REPLACE_WITH_FEISHU_CHAT_ID_OPS"
  },
  "default_channel": "ops",
  "services": {
    "jenkins": {
      "default_channel": "ci"
    },
    "helpdesk": {
      "default_channel": "support"
    },
    "manual": {
      "default_channel": "ops"
    }
  },
  "dedupe_ttl_seconds": 21600,
  "send_timeout_seconds": 15
}
