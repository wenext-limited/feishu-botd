# Copy this file to .env and set the Docker host bind IP.
# Main bot settings live in config/feishu-botd.json.

# Bind the host port to a specific interface when possible:
# FEISHU_BOTD_HOST_IP=REPLACE_WITH_HOST_BIND_IP
FEISHU_BOTD_HOST_IP=0.0.0.0

# Host directory that receives the daemon's Unix sockets (HTTP shim + gRPC).
# Agent providers on this host connect to `<dir>/feishu-botd.grpc.sock`.
# Ownership is fixed to uid/gid 10001 by the compose init service.
# FEISHU_BOTD_RUN_DIR=./run
